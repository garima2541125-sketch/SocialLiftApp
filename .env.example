# Which auth/data backend the app uses — 'firebase' (default, live) or
# 'sqlite' (on-device, native-only — iOS/Android, not web — see src/auth/).
# Switching later is just changing this value and restarting, no code edits.
EXPO_PUBLIC_AUTH_PROVIDER=firebase

# Firebase web app config (Project settings -> General -> Your apps -> SDK setup and configuration).
# These are safe to expose client-side — Firestore security rules (firestore.rules) are what
# actually protect the data, not these values. Copy this file to .env and fill them in.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local, free AI generation for the Create screen (src/ai/localAi.js).
# Qwen3 (captions) runs in Ollama, Qwen-Image (pictures) runs in ComfyUI —
# both on your own computer, no API key. Setup: docs/LOCAL_AI_SETUP.md.
# These defaults are what you get if you leave them unset.
EXPO_PUBLIC_OLLAMA_URL=http://127.0.0.1:11434
EXPO_PUBLIC_COMFYUI_URL=http://127.0.0.1:8188
EXPO_PUBLIC_CAPTION_MODEL=qwen3:8b
EXPO_PUBLIC_VISION_MODEL=qwen3-vl:4b-instruct
